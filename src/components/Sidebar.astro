---
import { buildCategoryTree, siteUrl } from '../lib/utils.js';

const { resources, activeCategory = '' } = Astro.props;
const catTree = buildCategoryTree(resources || []);
const total = (resources || []).length;
---

<aside class="sidebar">
  <h2 class="sidebar-title">分类</h2>
  <ul class="cat-list">
    <li>
      <a class={activeCategory ? 'cat-link' : 'cat-link active'} href={siteUrl('/')}>
        <span>全部收藏</span><span class="cnt">{total}</span>
      </a>
    </li>
    {
      catTree.map((node) => (
        <li>
          <a
            class={activeCategory === node.path ? 'cat-link active' : 'cat-link'}
            href={siteUrl(`/category/${node.path}`)}
          >
            <span>{node.name}</span><span class="cnt">{node.count}</span>
          </a>
          {node.children.length > 0 && (
            <ul class="cat-children">
              {node.children.map((child) => (
                <li>
                  <a
                    class={activeCategory === child.path ? 'cat-link active' : 'cat-link'}
                    href={siteUrl(`/category/${child.path}`)}
                  >
                    <span>{child.name}</span><span class="cnt">{child.count}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</aside>
