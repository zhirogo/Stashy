---
import Base from '../layouts/Base.astro';

// 服务端无法读取查询参数（SSG 模式），因此将全部资源数据内嵌到页面，
// 由客户端 JS 读取 ?q= 并完成搜索渲染。
const resources = Astro.locals.resources || [];
const dataJson = JSON.stringify({ resources });
const baseUrl = import.meta.env.BASE_URL;
---

<Base title="搜索">
  <section class="container page-head">
    <h1 class="page-title" id="search-result-title">搜索</h1>
    <p class="page-desc" id="search-result-desc">输入关键字，搜索收藏的标题、描述与标签。</p>
  </section>

  <section class="container">
    <div id="search-results">
      <div class="empty">
        <div class="big">🔍</div>
        <p>正在搜索…</p>
      </div>
    </div>
  </section>

  <script define:vars={{ dataJson, baseUrl }}>
    window.__STASHY_DATA__ = JSON.parse(dataJson);
    window.__STASHY_BASE__ = baseUrl;
  </script>
  <script>
    import { initSearch } from '../components/SearchClient';
    initSearch();
  </script>
</Base>
