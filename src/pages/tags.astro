---
import Base from '../layouts/Base.astro';
import { aggregateTags } from '../lib/utils.js';

const resources = Astro.locals.resources || [];
const tags = aggregateTags(resources);
---

<Base title="标签">
  <section class="container page-head">
    <h1 class="page-title">标签<span class="dim"> · 共 {tags.length} 个</span></h1>
    <p class="page-desc">按标签浏览全部收藏。</p>
  </section>

  <section class="container">
    {tags.length > 0 ? (
      <div class="tag-cloud">
        {tags.map((t) => (
          <a href={`/tag/${t.name}`}>
            {t.name} <span class="cnt">{t.count}</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty">
        <div class="big">🏷️</div>
        <p>还没有任何标签。</p>
      </div>
    )}
  </section>
</Base>
