---
import Base from '../layouts/Base.astro';
import ResourceCard from '../components/ResourceCard.astro';
import Sidebar from '../components/Sidebar.astro';
import {
  aggregateTags,
  sortResources,
  siteUrl,
} from '../lib/utils.js';
import { isUsingExampleData } from '../lib/data.js';

const resources = Astro.locals.resources || [];
const tags = aggregateTags(resources);

// URL 查询参数：分类筛选、标签筛选、排序
const q = Astro.url.searchParams;
const activeCategory = q.get('category') || '';
const activeTag = q.get('tag') || '';
const sort = q.get('sort') || 'latest';

let filtered = [...resources];
if (activeCategory) {
  filtered = filtered.filter((r) => r.category === activeCategory || (r.category || '').startsWith(activeCategory + '/'));
}
if (activeTag) {
  filtered = filtered.filter((r) => (r.tags || []).includes(activeTag));
}
filtered = sortResources(filtered, sort);

function buildQuery(updates) {
  const params = new URLSearchParams(q);
  for (const [k, v] of updates) {
    if (v) params.set(k, v);
    else params.delete(k);
  }
  const s = params.toString();
  return s ? `?${s}` : siteUrl('/');
}
---

<Base>
  <section class="container page-head">
    <h1 class="page-title">
      {activeCategory ? <span>分类 · <span class="dim">{activeCategory}</span></span>
        : activeTag ? <span>标签 · <span class="dim">{activeTag}</span></span>
        : <span>我的收藏</span>}
    </h1>
    <p class="page-desc">
      个人网址收藏站，集中整理与浏览技术、工具、阅读与生活的优质资源。
    </p>
    {isUsingExampleData && (
      <p class="data-hint">
        ⚠️ 当前展示的是示例数据。请在本地执行
        <code>cp data/resources.example.json data/resources.json</code>
        后重新构建，即可展示你的真实收藏。
      </p>
    )}
    <div class="meta-stats">
      <span>{resources.length} 条收藏</span>
      <span>{tags.length} 个标签</span>
    </div>
  </section>

  <section class="container">
    <div class="home-layout">
      <!-- 分类侧栏 -->
      <Sidebar resources={resources} activeCategory={activeCategory} />

      <!-- 资源列表 -->
      <div>
        <div class="toolbar">
          <div class="filter-pills">
            <a class={!activeTag ? 'pill active' : 'pill'} href={buildQuery([['tag', '']])}>全部</a>
            {tags.map((t) => (
              <a
                class={activeTag === t.name ? 'pill active' : 'pill'}
                href={buildQuery([['tag', t.name]])}
              >
                {t.name}
              </a>
            ))}
          </div>
          <select class="sort-select" onchange="const u=new URL(location.href);u.searchParams.set('sort',this.value);location.href=u.toString();">
            <option value="latest" selected={sort === 'latest'}>最新收藏</option>
            <option value="title" selected={sort === 'title'}>标题排序</option>
          </select>
        </div>

        {filtered.length > 0 ? (
          <div class="resource-grid">
            {filtered.map((r) => <ResourceCard resource={r} showCategory />)}
          </div>
        ) : (
          <div class="empty">
            <div class="big">🗂️</div>
            <p>该筛选条件下暂无收藏。</p>
          </div>
        )}
      </div>
    </div>
  </section>
</Base>
